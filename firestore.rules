rules_version = '2';

// Security model: every document in a user-owned collection carries an
// `ownerId` field (or, for `users/{userId}`, the uid is the document id
// itself) that must match the authenticated caller's uid. Nothing here
// trusts a userId supplied by the client for authorization decisions -
// only request.auth.uid, which Firebase Auth verifies server-side.
//
// This file is extended stage by stage as new collections
// (clients, assessments, assets, findings, evidence, reports) are added.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // For top-level owned collections (clients, assessments, assets,
    // findings, reports): the document must carry ownerId == caller's uid.
    // isOwnedRead covers read/delete (only today's owner matters).
    // isOwnedUpdate additionally requires the incoming write to keep the
    // same ownerId, so a user can never reassign one of their documents to
    // another uid (which would otherwise be a harmless-looking but
    // unnecessary way to mutate ownership metadata).
    // isOwnedCreate requires the new document's ownerId to match the
    // caller, so nobody can create data on another user's behalf.
    function isOwnedRead() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isOwnedUpdate() {
      return isOwnedRead() && request.resource.data.ownerId == resource.data.ownerId;
    }

    function isOwnedCreate() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      // uid/email/plan are not client-editable - the profile form only
      // ever sends name/company/phone/website, and this keeps it that way
      // even if called directly rather than through the app (e.g. no
      // client-side way to self-upgrade plan once paid tiers exist).
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.plan == resource.data.plan;
      allow delete: if false;
    }

    match /clients/{clientId} {
      allow read, delete: if isOwnedRead();
      allow update: if isOwnedUpdate();
      allow create: if isOwnedCreate();
    }

    match /assessments/{assessmentId} {
      allow read, delete: if isOwnedRead();
      allow update: if isOwnedUpdate();
      allow create: if isOwnedCreate();
    }

    match /assets/{assetId} {
      allow read, delete: if isOwnedRead();
      allow update: if isOwnedUpdate();
      allow create: if isOwnedCreate();
    }

    match /scope/{scopeItemId} {
      allow read, delete: if isOwnedRead();
      allow update: if isOwnedUpdate();
      allow create: if isOwnedCreate();
    }

    match /findings/{findingId} {
      allow read, delete: if isOwnedRead();
      allow update: if isOwnedUpdate();
      allow create: if isOwnedCreate();
    }

    match /evidence/{evidenceId} {
      allow read, delete: if isOwnedRead();
      allow update: if isOwnedUpdate();
      allow create: if isOwnedCreate();
    }

    match /reports/{reportId} {
      allow read, delete: if isOwnedRead();
      allow update: if isOwnedUpdate();
      allow create: if isOwnedCreate();
    }

    // Built-in finding templates are readable by any signed-in user and
    // are only ever written by administrators via the Firebase console
    // or a trusted backend - never directly by the app.
    match /findingTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Default deny: any collection not explicitly opened above is
    // inaccessible until a rule for it is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
